# ADMIN_LOGIN_EMAIL=admin@domeniul-tau.ro
# ADMIN_PASSWORD=schimba-parola

# Google reCAPTCHA v2 – formular contact (obține chei: https://www.google.com/recaptcha/admin)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=cheie_publica
# RECAPTCHA_SECRET_KEY=cheie_secreta

# Email – rezervări (Resend.com). Fără cheie, rezervările se salvează dar nu se trimit email-uri.
# RESEND_API_KEY=re_xxxx
# FROM_EMAIL=noreply@domeniul-tau.ro   (domeniu verificat în Resend)
# ADMIN_EMAIL=rezervari@888rentacar.ro (unde primești notificările de rezervări)
