# Login panou admin (obligatoriu în producție)
# ADMIN_LOGIN_EMAIL=admin@domeniul-tau.ro
# ADMIN_PASSWORD=schimba-parola
# Cont secundar, opțional. Poate vedea și edita mașini, fără să adauge sau să șteargă.
# ADMIN_LOGIN_EMAIL_2=rezervari@domeniul-tau.ro
# ADMIN_PASSWORD_2=alta-parola

# Google reCAPTCHA v2 – formular contact (obține chei: https://www.google.com/recaptcha/admin)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=cheie_publica
# RECAPTCHA_SECRET_KEY=cheie_secreta

# Email – rezervări și contact. Fără SMTP sau Resend, datele se salvează dar nu se trimit email-uri.
# Varianta 1: căsuța de email de pe hosting (SMTP)
# SMTP_HOST=mail.domeniul-tau.ro
# SMTP_PORT=465
# SMTP_USER=rezervari@domeniul-tau.ro
# SMTP_PASS=parola-casutei
# Varianta 2: Resend.com
# RESEND_API_KEY=re_xxxx
# FROM_EMAIL=rezervari@domeniul-tau.ro   (implicit: SMTP_USER)
# ADMIN_EMAIL=rezervari@trtrentacar.ro,alta-adresa@exemplu.ro (unde primești notificările; mai multe adrese separate prin virgulă)
